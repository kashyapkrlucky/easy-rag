# EasyRAG configuration.  Nothing here is required: `docker compose up -d` works without
# a .env file. To change a setting:
#
#   cp .env.example .env      then uncomment and edit only the lines you need.
#
# Every value below is commented out and shows the default. Settings you don't set follow
# the defaults of future versions too (for example a better default model).

# =============================================================================
# Common settings
# =============================================================================

# Folder with your Markdown files (mounted read-only). Default: ./docs
# EASYRAG_DOCS_HOST_DIR=./docs

# Host port for the web UI and API, always bound to 127.0.0.1.
# EASYRAG_PORT=8000

# API key. Set one before making EasyRAG reachable from other machines (with a TLS reverse
# proxy in front). All endpoints except /health/*, /docs and the web page then require it,
# as "Authorization: Bearer <key>" or "X-API-Key: <key>". At least 16 characters:
#   openssl rand -hex 32
# EASYRAG_API_KEY=

# Chat model (pin a tag). The default (~1 GB) fits a 4 GB Docker VM, Docker Desktop's
# default on an 8 GB Mac. Better answers need more memory; raise EASYRAG_OLLAMA_MEMORY_LIMIT
# with them (CPU inference needs roughly 1.6x the model size):
#   qwen2.5:1.5b-instruct-q4_K_M    ~1 GB    default
#   llama3.2:3b                     2.0 GB   EASYRAG_OLLAMA_MEMORY_LIMIT=4g
#   qwen3:4b-instruct-2507-q4_K_M   2.5 GB   EASYRAG_OLLAMA_MEMORY_LIMIT=5g
# Missing models are downloaded automatically on start.
# EASYRAG_LLM_MODEL=qwen2.5:1.5b-instruct-q4_K_M

# Use an Ollama installed on the host instead of the bundled container (much faster on
# macOS, where Docker can't use the GPU). See docker-compose.host-ollama.yml.
# COMPOSE_FILE=docker-compose.yml:docker-compose.host-ollama.yml

# =============================================================================
# Resources (Docker Compose). Upper limits, not reservations.
# =============================================================================
# EASYRAG_OLLAMA_MEMORY_LIMIT=3g
# EASYRAG_APP_MEMORY_LIMIT=1g
# EASYRAG_DB_MEMORY_LIMIT=1g
# How long Ollama keeps models loaded after the last request (reloading takes ~10 s on CPU).
# OLLAMA_KEEP_ALIVE=1h
# Concurrent requests per model; each one multiplies context memory.
# OLLAMA_NUM_PARALLEL=1

# =============================================================================
# Web and API
# =============================================================================
# Serve the chat page at / (false = API only).
# EASYRAG_UI_ENABLED=true
# Browser origins allowed to call the API from other sites, comma-separated
# (e.g. https://wiki.example.com). Empty = CORS off; the built-in page doesn't need it.
# EASYRAG_CORS_ALLOW_ORIGINS=
# Larger request bodies are rejected with 413.
# EASYRAG_MAX_REQUEST_BYTES=65536

# =============================================================================
# Indexing
# =============================================================================
# Index in the background on start, and re-index when files change. If changes on a
# network filesystem aren't noticed, set FORCE_POLLING=true. The resync (seconds, 0 = off)
# is a safety net for anything the watcher missed.
# EASYRAG_INDEX_ON_STARTUP=true
# EASYRAG_WATCH_ENABLED=true
# EASYRAG_WATCH_FORCE_POLLING=false
# EASYRAG_WATCH_DEBOUNCE_MS=1000
# EASYRAG_WATCH_RESYNC_SECONDS=300

# Chunk size in estimated tokens (including the section header), and overlap.
# Changing them re-embeds everything on the next run.
# EASYRAG_CHUNK_MAX_TOKENS=400
# EASYRAG_CHUNK_OVERLAP_TOKENS=50

# =============================================================================
# Retrieval and answering
# =============================================================================
# hybrid (vector + keyword, fused) is the default; vector or keyword alone for comparison.
# EASYRAG_RETRIEVAL_MODE=hybrid
# EASYRAG_RETRIEVAL_TOP_K=5
# Minimum cosine similarity for vector results (default: off). Useful values depend on the
# model and your documents; `easyrag eval` suggests one (ARCHITECTURE D34).
# EASYRAG_RETRIEVAL_MIN_SCORE=0.70

# Cross-encoder reranking (CPU, ~80 MB download, ~1 s per question). Off by default: no
# measurable gain on the project's test questions (ARCHITECTURE D33). Try it on yours.
# Multilingual alternative (~570 MB): BAAI/bge-reranker-v2-m3-int8
# EASYRAG_RERANK_ENABLED=false
# EASYRAG_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# EASYRAG_RERANK_CANDIDATES=20

# Maximum evidence in the prompt (estimated tokens). More can help, but on CPU prompt size
# dominates response time.
# EASYRAG_RAG_MAX_CONTEXT_TOKENS=2000
# An answer that cites nothing: refuse ("I don't know based on the provided documents.")
# or flag (returned with "grounded": false).
# EASYRAG_RAG_UNGROUNDED_POLICY=refuse
# Instruction-like text in documents ("ignore all previous instructions ...") is removed
# from what the model sees (redact), so a poisoned document can't hijack answers. Use off
# for a corpus about prompts and LLMs, whose examples would otherwise be removed.
# EASYRAG_RAG_INJECTION_FILTER=redact
# Questions answered at the same time; more get "busy" (503, Retry-After) instead of
# queueing behind slow CPU generation.
# EASYRAG_CHAT_MAX_CONCURRENT=4

# Tokens per request (prompt + answer); larger is slower and uses more memory.
# EASYRAG_LLM_CONTEXT_WINDOW=8192
# Deterministic by default; longer answers are cut off and flagged.
# EASYRAG_LLM_TEMPERATURE=0
# EASYRAG_LLM_SEED=42
# EASYRAG_LLM_MAX_OUTPUT_TOKENS=512

# =============================================================================
# Embeddings. Changing the model needs the matching DIMENSION and PREFIXES, and a
# rebuild of the index:  docker compose run --rm app easyrag index --rebuild
# =============================================================================
#   nomic-embed-text:v1.5   768   "search_query: " / "search_document: "   (default; English)
#   embeddinggemma:300m     768   "task: search result | query: " / "title: none | text: "
#   qwen3-embedding:0.6b    1024  see the model card for its query instruction format
# Keep the quotes: the prefixes end with a space.
# EASYRAG_EMBEDDING_MODEL=nomic-embed-text:v1.5
# EASYRAG_EMBEDDING_DIMENSION=768
# EASYRAG_EMBEDDING_BATCH_SIZE=32
# EASYRAG_EMBEDDING_QUERY_PREFIX="search_query: "
# EASYRAG_EMBEDDING_DOCUMENT_PREFIX="search_document: "

# =============================================================================
# Ollama
# =============================================================================
# Default in Compose: the bundled service (http://ollama:11434); outside Docker:
# http://localhost:11434.
# EASYRAG_OLLAMA_BASE_URL=http://ollama:11434
# EASYRAG_OLLAMA_TIMEOUT_SECONDS=300
# Download missing models on start (false for curated or offline Ollama hosts; then run
# `docker compose run --rm app easyrag models pull` or `ollama pull` yourself).
# EASYRAG_OLLAMA_PULL_MODELS=true

# =============================================================================
# Logging
# =============================================================================
# EASYRAG_LOG_LEVEL=INFO
# json (for log collectors) or text (readable).
# EASYRAG_LOG_FORMAT=json
# EASYRAG_HEALTH_CHECK_TIMEOUT_SECONDS=2

# =============================================================================
# Database (Docker Compose)
# =============================================================================
# The password is generated on first start and stored in the "secrets" volume. Set one only
# to keep an existing database working (installations from before the password was
# generated). PostgreSQL uses it only when it first creates its data. Any characters work.
# POSTGRES_PASSWORD=
# POSTGRES_USER=easyrag
# POSTGRES_DB=easyrag

# =============================================================================
# Development (not needed to run EasyRAG)
# =============================================================================
# docker-compose.dev.yml publishes PostgreSQL and Ollama on these host ports.
# EASYRAG_DB_PORT=5432
# EASYRAG_OLLAMA_PORT=11434
# Running outside Docker (uv run ...) needs a database URL:
# EASYRAG_DATABASE_URL=postgresql+psycopg://easyrag:<password>@127.0.0.1:5432/easyrag
# or a URL without the password plus EASYRAG_DATABASE_PASSWORD_FILE=<path>.
# Integration and end-to-end tests run against these when set (skipped otherwise):
# EASYRAG_TEST_DATABASE_URL=postgresql+psycopg://easyrag:<password>@127.0.0.1:5432/easyrag
# EASYRAG_TEST_OLLAMA_URL=http://127.0.0.1:11434
