# EasyRAG configuration. Copy to .env and adjust:  cp .env.example .env
# Every variable is optional unless marked "required".

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
EASYRAG_LOG_LEVEL=INFO
# json (one object per line, for log collectors) or text (human-readable, for development)
EASYRAG_LOG_FORMAT=json

# Seconds allowed for each dependency check in /health/ready
EASYRAG_HEALTH_CHECK_TIMEOUT_SECONDS=2

# --- HTTP API -----------------------------------------------------------------
# API key: when set, all endpoints except /health/* and the API docs require it, as
# "Authorization: Bearer <key>" or "X-API-Key: <key>". At least 16 characters; generate one
# with:  openssl rand -hex 32
# Empty = no authentication (only safe while the API is published on localhost).
EASYRAG_API_KEY=
# Browser origins allowed to call the API from other sites, comma-separated
# (e.g. https://wiki.example.com). Empty = CORS disabled (same-origin only).
EASYRAG_CORS_ALLOW_ORIGINS=
# Larger request bodies are rejected with 413
EASYRAG_MAX_REQUEST_BYTES=65536

# --- Documents ----------------------------------------------------------------
# Docker Compose: host directory with your Markdown files (mounted read-only at /data/docs).
EASYRAG_DOCS_HOST_DIR=./docs
# Outside Docker: directory to index (relative to the working directory).
# EASYRAG_DOCS_DIR=docs

# Chunk size in estimated tokens (including the section header) and overlap between chunks.
# Changing them changes every chunk: the next index run re-embeds everything.
EASYRAG_CHUNK_MAX_TOKENS=400
EASYRAG_CHUNK_OVERLAP_TOKENS=50

# Index in the background when the API starts (incremental: unchanged files cost nothing).
EASYRAG_INDEX_ON_STARTUP=true

# Re-index automatically when Markdown files change. If changes on a bind mount or network
# filesystem are not noticed, set FORCE_POLLING=true. The periodic resync (seconds; 0 = off)
# is a safety net that catches anything the watcher missed.
EASYRAG_WATCH_ENABLED=true
EASYRAG_WATCH_FORCE_POLLING=false
EASYRAG_WATCH_DEBOUNCE_MS=1000
EASYRAG_WATCH_RESYNC_SECONDS=300

# --- Retrieval ----------------------------------------------------------------
# hybrid (vector + keyword, fused) is the default; vector or keyword alone for comparison.
EASYRAG_RETRIEVAL_MODE=hybrid
EASYRAG_RETRIEVAL_TOP_K=5

# --- Reranking ----------------------------------------------------------------
# A small cross-encoder (CPU, ~80 MB, downloaded once) reorders the best candidates.
# Off by default: on the project's test queries it added ~1.3 s per question without a
# measurable gain over hybrid retrieval (ARCHITECTURE D33). Try it on your documents.
# Multilingual alternative (larger, ~570 MB): BAAI/bge-reranker-v2-m3-int8
EASYRAG_RERANK_ENABLED=false
EASYRAG_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
EASYRAG_RERANK_CANDIDATES=20

# --- Ollama -------------------------------------------------------------------
# Compose default: the bundled ollama service. On macOS, Docker cannot use the Apple GPU,
# so a host Ollama is much faster: EASYRAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
# (run `ollama pull <model>` on the host yourself in that case).
# Outside Docker the default is http://localhost:11434.
# EASYRAG_OLLAMA_BASE_URL=http://ollama:11434
EASYRAG_OLLAMA_TIMEOUT_SECONDS=300

# --- Embeddings ---------------------------------------------------------------
# Changing the model requires matching DIMENSION and PREFIXES (they are model-specific),
# and re-indexing: docker compose run --rm app easyrag index --rebuild
#   nomic-embed-text:v1.5   768   "search_query: " / "search_document: "   (default; English)
#   embeddinggemma:300m     768   "task: search result | query: " / "title: none | text: "
#   qwen3-embedding:0.6b    1024  see the model card for its query instruction format
# Keep the quotes: prefixes end with a space.
EASYRAG_EMBEDDING_MODEL=nomic-embed-text:v1.5
EASYRAG_EMBEDDING_DIMENSION=768
EASYRAG_EMBEDDING_BATCH_SIZE=32
EASYRAG_EMBEDDING_QUERY_PREFIX="search_query: "
EASYRAG_EMBEDDING_DOCUMENT_PREFIX="search_document: "

# --- Chat model ---------------------------------------------------------------
# Pin a tag. Default: Qwen2.5 1.5B instruct (~1 GB, Apache-2.0). It fits a 4 GB Docker VM
# (Docker Desktop's default on an 8 GB Mac) next to the embedding model and PostgreSQL.
# Better answers, more memory (CPU inference in Docker needs roughly 1.6x the model size):
#   qwen3:4b-instruct-2507-q4_K_M   2.5 GB   needs ~4.5 GB for Ollama alone
#   llama3.2:3b                     2.0 GB
# On macOS, a native Ollama (Apple GPU, no Docker memory limit) is the fastest option:
# EASYRAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
EASYRAG_LLM_MODEL=qwen2.5:1.5b-instruct-q4_K_M
# Tokens per request (prompt + answer), always sent to Ollama as num_ctx.
# Larger windows fit more evidence but use more memory and are slower on CPU.
EASYRAG_LLM_CONTEXT_WINDOW=8192

# Generation: deterministic by default; answers longer than this are cut off and flagged.
EASYRAG_LLM_TEMPERATURE=0
EASYRAG_LLM_SEED=42
EASYRAG_LLM_MAX_OUTPUT_TOKENS=512

# --- Answering (RAG) ------------------------------------------------------------
# Maximum retrieved evidence in the prompt (estimated tokens). More evidence can help
# answers but costs latency: on CPU, prompt size dominates response time.
EASYRAG_RAG_MAX_CONTEXT_TOKENS=2000
# Answers must cite the documents as [n]. For a reply that cites nothing:
#   refuse - answer "I don't know based on the provided documents." instead (strict)
#   flag   - return it anyway with "status": "ungrounded" / "grounded": false
EASYRAG_RAG_UNGROUNDED_POLICY=refuse

# --- Docker Compose ---------------------------------------------------------
# PostgreSQL credentials. POSTGRES_PASSWORD is required: choose your own value.
# Use URL-safe characters (letters, digits, - _ .) because it is embedded in a URL.
POSTGRES_USER=easyrag
POSTGRES_PASSWORD=
POSTGRES_DB=easyrag

# Host port the API is published on (always bound to 127.0.0.1)
EASYRAG_PORT=8000

# Development only (docker-compose.dev.yml): host ports for PostgreSQL and Ollama
EASYRAG_DB_PORT=5432
EASYRAG_OLLAMA_PORT=11434

# --- Running outside Docker (uv run ...) ------------------------------------
# Required when not using Docker Compose (Compose builds it from POSTGRES_* above).
# EASYRAG_DATABASE_URL=postgresql+psycopg://easyrag:<password>@127.0.0.1:5432/easyrag

# Integration tests (pytest) connect here; tests are skipped when unset.
# EASYRAG_TEST_DATABASE_URL=postgresql+psycopg://easyrag:<password>@127.0.0.1:5432/easyrag
# End-to-end tests against a real Ollama; skipped when unset.
# EASYRAG_TEST_OLLAMA_URL=http://127.0.0.1:11434
