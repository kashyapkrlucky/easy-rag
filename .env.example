# EasyRAG configuration. Copy to .env and adjust:  cp .env.example .env
# Every variable is optional unless marked "required".

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
EASYRAG_LOG_LEVEL=INFO

# Seconds allowed for each dependency check in /health/ready
EASYRAG_HEALTH_CHECK_TIMEOUT_SECONDS=2

# --- Ollama -------------------------------------------------------------------
# Compose default: the bundled ollama service. On macOS, Docker cannot use the Apple GPU,
# so a host Ollama is much faster: EASYRAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
# (run `ollama pull <model>` on the host yourself in that case).
# Outside Docker the default is http://localhost:11434.
# EASYRAG_OLLAMA_BASE_URL=http://ollama:11434
EASYRAG_OLLAMA_TIMEOUT_SECONDS=120

# --- Embeddings ---------------------------------------------------------------
# Changing the model requires matching DIMENSION and PREFIXES (they are model-specific):
#   nomic-embed-text:v1.5   768   "search_query: " / "search_document: "   (default; English)
#   embeddinggemma:300m     768   "task: search result | query: " / "title: none | text: "
#   qwen3-embedding:0.6b    1024  see the model card for its query instruction format
# Keep the quotes: prefixes end with a space.
EASYRAG_EMBEDDING_MODEL=nomic-embed-text:v1.5
EASYRAG_EMBEDDING_DIMENSION=768
EASYRAG_EMBEDDING_BATCH_SIZE=32
EASYRAG_EMBEDDING_QUERY_PREFIX="search_query: "
EASYRAG_EMBEDDING_DOCUMENT_PREFIX="search_document: "

# --- Docker Compose ---------------------------------------------------------
# PostgreSQL credentials. POSTGRES_PASSWORD is required: choose your own value.
# Use URL-safe characters (letters, digits, - _ .) because it is embedded in a URL.
POSTGRES_USER=easyrag
POSTGRES_PASSWORD=
POSTGRES_DB=easyrag

# Host port the API is published on (always bound to 127.0.0.1)
EASYRAG_PORT=8000

# Development only (docker-compose.dev.yml): host ports for PostgreSQL and Ollama
EASYRAG_DB_PORT=5432
EASYRAG_OLLAMA_PORT=11434

# --- Running outside Docker (uv run ...) ------------------------------------
# Required when not using Docker Compose (Compose builds it from POSTGRES_* above).
# EASYRAG_DATABASE_URL=postgresql+psycopg://easyrag:<password>@127.0.0.1:5432/easyrag

# Integration tests (pytest) connect here; tests are skipped when unset.
# EASYRAG_TEST_DATABASE_URL=postgresql+psycopg://easyrag:<password>@127.0.0.1:5432/easyrag
# End-to-end tests against a real Ollama; skipped when unset.
# EASYRAG_TEST_OLLAMA_URL=http://127.0.0.1:11434
